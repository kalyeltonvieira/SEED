module seedci

import stdlib.io
import stdlib.fs
import stdlib.string
import stdlib.json
import stdlib.cli

/// CI/CD Integration for SEED projects
type CIConfig = {
    stages: [string]
    jobs: dict
    environment: dict
    artifacts: [string]
}

type CIJob = {
    name: string
    stage: string
    script: [string]
    variables: dict
    artifacts: [string]
}

type CIResult = {
    job: string
    stage: string
    status: string
    duration: float
    output: string
}

fn ci_config() -> CIConfig {
    return CIConfig {
        stages: ["build", "test", "lint", "deploy"],
        jobs: dict(),
        environment: dict(),
        artifacts: []
    }
}

fn load_ci_config(path: string) -> CIConfig {
    if !fs.file_exists(path) {
        return ci_config()
    }
    
    let content = fs.read_file(path)
    let data = json.parse(content).unwrap()
    
    let config = ci_config()
    
    if data.data.contains("stages") {
        config.stages = data.data["stages"].data.map(s => s.data)
    }
    
    if data.data.contains("environment") {
        for (key, value) in data.data["environment"].data {
            config.environment[key] = value.data
        }
    }
    
    if data.data.contains("artifacts") {
        config.artifacts = data.data["artifacts"].data.map(a => a.data)
    }
    
    return config
}

fn add_job(config: CIConfig, job: CIJob) {
    config.jobs[job.name] = job
}

fn run_stage(config: CIConfig, stage: string) -> [CIResult] {
    let results = []
    
    println("Running stage: " + stage)
    
    for (name, job) in config.jobs {
        if job.stage == stage {
            let result = run_job(job)
            results.push(result)
        }
    }
    
    return results
}

fn run_job(job: CIJob) -> CIResult {
    println("  Running job: " + job.name)
    
    let start = time.now()
    let output = ""
    let status = "success"
    
    // Set environment variables
    for (key, value) in job.variables {
        os.set_env(key, value)
    }
    
    // Run script
    for line in job.script {
        println("    " + line)
        
        let result = execute_command(line)
        output = output + result.stdout + "\n"
        
        if result.exit_code != 0 {
            status = "failed"
            break
        }
    }
    
    let duration = time.elapsed(start)
    
    return CIResult {
        job: job.name,
        stage: job.stage,
        status: status,
        duration: time.to_millis(duration),
        output: output
    }
}

fn execute_command(cmd: string) -> { stdout: string, exit_code: int } {
    // In real implementation, this would execute the command
    // For now, return simulated result
    return { stdout: "", exit_code: 0 }
}

fn run_pipeline(config: CIConfig) -> [CIResult] {
    let all_results = []
    
    println("=== CI Pipeline ===")
    println("Stages: " + config.stages.join(", "))
    println("")
    
    for stage in config.stages {
        let results = run_stage(config, stage)
        all_results = all_results + results
        
        // Check if any job failed
        for result in results {
            if result.status == "failed" {
                println("\nPipeline failed at stage: " + stage)
                return all_results
            }
        }
    }
    
    println("\nPipeline completed successfully!")
    return all_results
}

fn generate_github_actions(config: CIConfig) -> string {
    let yaml = "name: SEED CI\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n"
    
    for (name, job) in config.jobs {
        yaml = yaml + "  " + name + ":\n"
        yaml = yaml + "    runs-on: ubuntu-latest\n"
        yaml = yaml + "    steps:\n"
        yaml = yaml + "      - uses: actions/checkout@v2\n"
        yaml = yaml + "      - name: Setup SEED\n"
        yaml = yaml + "        run: |\n"
        
        for line in job.script {
            yaml = yaml + "          " + line + "\n"
        }
        
        yaml = yaml + "\n"
    }
    
    return yaml
}

fn generate_gitlab_ci(config: CIConfig) -> string {
    let yaml = "stages:\n"
    
    for stage in config.stages {
        yaml = yaml + "  - " + stage + "\n"
    }
    
    yaml = yaml + "\n"
    
    for (name, job) in config.jobs {
        yaml = yaml + name + ":\n"
        yaml = yaml + "  stage: " + job.stage + "\n"
        yaml = yaml + "  script:\n"
        
        for line in job.script {
            yaml = yaml + "    - " + line + "\n"
        }
        
        yaml = yaml + "\n"
    }
    
    return yaml
}

fn generate_travis_ci(config: CIConfig) -> string {
    let yaml = "language: generic\n\n"
    
    let stages = "stages:\n"
    for stage in config.stages {
        stages = stages + "  - " + stage + "\n"
    }
    
    yaml = yaml + stages + "\n"
    
    let matrix = "jobs:\n  include:\n"
    for (name, job) in config.jobs {
        matrix = matrix + "    - stage: " + job.stage + "\n"
        matrix = matrix + "      name: \"" + name + "\"\n"
        matrix = matrix + "      script: " + job.script.join(" && ") + "\n"
    }
    
    yaml = yaml + matrix
    
    return yaml
}

fn print_report(results: [CIResult]) {
    println("\n" + cli.color("=" * 60, "white"))
    println("CI Report")
    println(cli.color("=" * 60, "white"))
    
    let total = results.len
    let passed = results.filter(r => r.status == "success").len
    let failed = results.filter(r => r.status == "failed").len
    
    println("Total: " + total.to_string())
    println(cli.color("Passed: " + passed.to_string(), "green"))
    println(cli.color("Failed: " + failed.to_string(), "red"))
    
    println("\nJob Details:")
    for result in results {
        let status_color = if result.status == "success" { "green" } else { "red" }
        println("  " + cli.color(result.job, "white") + " [" + 
              cli.color(result.status, status_color) + "] " +
              result.duration.to_string() + "ms")
    }
}

fn main(args: [string]) {
    let config_path = ".seed-ci.json"
    let output_format = "console"
    let generate_only = false
    
    for i in 0..args.len {
        if args[i] == "--config" && i + 1 < args.len {
            config_path = args[i + 1]
        } else if args[i] == "--format" && i + 1 < args.len {
            output_format = args[i + 1]
        } else if args[i] == "--generate" {
            generate_only = true
        }
    }
    
    println("SEED CI/CD v1.0")
    println("Config: " + config_path)
    println("")
    
    let config = load_ci_config(config_path)
    
    // Add default jobs if none exist
    if config.jobs.len == 0 {
        add_job(config, CIJob {
            name: "build",
            stage: "build",
            script: ["seed build"],
            variables: dict(),
            artifacts: ["build/"]
        })
        
        add_job(config, CIJob {
            name: "test",
            stage: "test",
            script: ["seed test"],
            variables: dict(),
            artifacts: []
        })
        
        add_job(config, CIJob {
            name: "lint",
            stage: "lint",
            script: ["seed lint"],
            variables: dict(),
            artifacts: []
        })
    }
    
    if generate_only {
        match output_format {
            "github" => {
                let yaml = generate_github_actions(config)
                fs.write_file(".github/workflows/ci.yml", yaml)
                println("Generated .github/workflows/ci.yml")
            }
            "gitlab" => {
                let yaml = generate_gitlab_ci(config)
                fs.write_file(".gitlab-ci.yml", yaml)
                println("Generated .gitlab-ci.yml")
            }
            "travis" => {
                let yaml = generate_travis_ci(config)
                fs.write_file(".travis.yml", yaml)
                println("Generated .travis.yml")
            }
            _ => {
                println("Unknown format: " + output_format)
            }
        }
        return
    }
    
    let results = run_pipeline(config)
    print_report(results)
    
    let failed = results.filter(r => r.status == "failed").len
    if failed > 0 {
        os.exit(1)
    }
}
