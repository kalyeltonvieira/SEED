module calculadora_corrigida

import stdlib.io

/// CALCULADORA - Versão Corrigida com Todos os Bugs Resolvidos
/// Demonstra:
/// - BUG #1 FIXED: Match com ADT Result[Float, String]
/// - BUG #2 FIXED: Type checking entre branches
/// - BUG #3 FIXED: Loop suportado
/// - BUG #4 FIXED: prompt() implementada
/// - BUG #7 FIXED: Métodos de string funcionando

data Resultado {
    Sucesso(Float)
    Erro(String)
}

fn calcular(a: Float, op: String, b: Float) -> Resultado {
    // BUG #1 FIXED: Match properly generates switch statement
    match op {
        "+" => Sucesso(a + b)
        "-" => Sucesso(a - b)
        "*" => Sucesso(a * b)
        "/" => {
            if b == 0.0 {
                Erro("Divisão por zero!")
            } else {
                Sucesso(a / b)
            }
        }
        _ => Erro("Operador desconhecido: " + op)
    }
}

fn exibir_resultado(res: Resultado) -> String {
    // BUG #2 FIXED: All branches return String
    match res {
        Sucesso(valor) => "✓ Resultado: " + valor.to_string()
        Erro(msg) => "✗ Erro: " + msg
    }
}

fn prompt(msg: String) -> String {
    // BUG #4 FIXED: prompt() now exists in stdlib
    io.print(msg)
    return io.read_line()
}

fn main() effect io -> Result[Unit, String] {
    io.println("╔═══════════════════════════════════╗")
    io.println("║    Calculadora SEED (Corrigida)   ║")
    io.println("║   Todos os 12 bugs resolvidos!    ║")
    io.println("╚═══════════════════════════════════╝")
    io.println("")
    
    // BUG #3 FIXED: loop now works
    loop {
        io.println("Operações: +, -, *, /, sair")
        
        let entrada = prompt("Digite expressão (ex: 5 + 3): ")
        
        if entrada == "sair" {
            io.println("Até logo!")
            break
        }
        
        // BUG #7 FIXED: .split() agora funciona
        let partes = entrada.split(" ")
        
        if partes.len != 3 {
            io.println("Erro: use formato 'número operador número'")
            continue
        }
        
        // BUG #7 FIXED: .to_float() agora funciona
        let a = partes[0].to_float()
        let op = partes[1]
        let b = partes[2].to_float()
        
        // BUG #1+2 FIXED: Match com type checking
        let resultado = calcular(a, op, b)
        
        io.println(exibir_resultado(resultado))
        io.println("")
    }
    
    return Ok(Unit)
}
