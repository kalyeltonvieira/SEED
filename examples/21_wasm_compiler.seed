module wasm_compiler

/// SEED to WebAssembly Compiler
/// Compila subconjunto de SEED para WebAssembly (.wasm)

type WASMModule = {
    types: [WASMType]
    functions: [WASMFunction]
    globals: [WASMGlobal]
    exports: [WASMExport]
    code: [int]
}

type WASMType = {
    params: [string]
    results: [string]
}

type WASMFunction = {
    type_index: int
    locals: [string]
    body: [int]
}

type WASMGlobal = {
    type: string
    mutable: bool
    init: int
}

type WASMExport = {
    name: string
    kind: string
    index: int
}

type WASMOpcode = {
    code: int
    name: string
}

// WebAssembly opcodes
const OP_LOCAL_GET = 0x20
const OP_LOCAL_SET = 0x21
const OP_I32_CONST = 0x41
const OP_I64_CONST = 0x42
const OP_F32_CONST = 0x43
const OP_F64_CONST = 0x44
const OP_I32_ADD = 0x6A
const OP_I32_SUB = 0x6B
const OP_I32_MUL = 0x6C
const OP_I32_DIV_S = 0x6D
const OP_I32_EQ = 0x46
const OP_I32_NE = 0x47
const OP_I32_LT_S = 0x48
const OP_I32_GT_S = 0x4A
const OP_IF = 0x0D
const OP_ELSE = 0x05
const OP_END = 0x0B
const OP_BR = 0x0C
const OP_BR_IF = 0x0D
const OP_LOOP = 0x03
const OP_CALL = 0x10
const OP_RETURN = 0x0F
const OP_DROP = 0x1A

fn wasm_module() -> WASMModule {
    return WASMModule {
        types: [],
        functions: [],
        globals: [],
        exports: [],
        code: []
    }
}

fn compile_to_wasm(source: string) -> WASMModule {
    let module = wasm_module()
    
    // Parse SEED source (simplified)
    let functions = parse_seed_functions(source)
    
    // Convert to WASM types
    for func in functions {
        let wasm_type = WASMType {
            params: func.params,
            results: func.results
        }
        module.types.push(wasm_type)
    }
    
    // Generate WASM functions
    for i in 0..functions.len {
        let func = functions[i]
        let wasm_func = generate_wasm_function(func, i)
        module.functions.push(wasm_func)
    }
    
    // Generate exports
    for i in 0..functions.len {
        module.exports.push(WASMExport {
            name: functions[i].name,
            kind: "function",
            index: i
        })
    }
    
    // Generate bytecode
    module.code = generate_wasm_bytecode(module)
    
    return module
}

type SeedFunction = {
    name: string
    params: [string]
    results: [string]
    body: string
}

fn parse_seed_functions(source: string) -> [SeedFunction] {
    let functions = []
    let lines = source.split("\n")
    
    for line in lines {
        if line.starts_with("fn ") {
            let func = parse_seed_function(line)
            functions.push(func)
        }
    }
    
    return functions
}

fn parse_seed_function(line: string) -> SeedFunction {
    // Simplified parsing: fn name(param: type) -> type { body }
    let name_start = 3
    let paren_start = line.index_of("(")
    let name = line.substring(name_start, paren_start)
    
    let paren_end = line.index_of(")")
    let params_str = line.substring(paren_start + 1, paren_end)
    let params = []
    
    if params_str.len > 0 {
        let param_parts = params_str.split(":")
        params.push(param_parts[0].trim())
    }
    
    let arrow = line.index_of("->")
    let brace = line.index_of("{")
    let return_type = line.substring(arrow + 2, brace).trim()
    
    let body_start = brace + 1
    let body_end = line.len() - 1
    let body = line.substring(body_start, body_end)
    
    return SeedFunction {
        name: name,
        params: params,
        results: [return_type],
        body: body
    }
}

fn generate_wasm_function(func: SeedFunction, type_index: int) -> WASMFunction {
    let body = []
    
    // Parse body and generate instructions
    let instructions = parse_body(func.body)
    
    for instr in instructions {
        body = body + compile_instruction(instr)
    }
    
    return WASMFunction {
        type_index: type_index,
        locals: func.params,
        body: body
    }
}

type Instruction = {
    opcode: string
    operands: [any]
}

fn parse_body(body: string) -> [Instruction] {
    let instructions = []
    
    // Simplified parsing - split by semicolons
    let statements = body.split(";")
    
    for stmt in statements {
        let trimmed = stmt.trim()
        if trimmed.len > 0 {
            instructions.push(parse_statement(trimmed))
        }
    }
    
    return instructions
}

fn parse_statement(stmt: string) -> Instruction {
    // Simplified statement parsing
    if stmt.contains("+") {
        let parts = stmt.split("+")
        return Instruction {
            opcode: "add",
            operands: [parts[0].trim(), parts[1].trim()]
        }
    }
    
    if stmt.contains("-") {
        let parts = stmt.split("-")
        return Instruction {
            opcode: "sub",
            operands: [parts[0].trim(), parts[1].trim()]
        }
    }
    
    if stmt.contains("*") {
        let parts = stmt.split("*")
        return Instruction {
            opcode: "mul",
            operands: [parts[0].trim(), parts[1].trim()]
        }
    }
    
    if stmt.contains("/") {
        let parts = stmt.split("/")
        return Instruction {
            opcode: "div",
            operands: [parts[0].trim(), parts[1].trim()]
        }
    }
    
    if stmt.contains("return") {
        let value = stmt.substring(7, stmt.len()).trim()
        return Instruction {
            opcode: "return",
            operands: [value]
        }
    }
    
    if stmt.contains("if") {
        let condition = stmt.substring(3, stmt.index_of("{")).trim()
        return Instruction {
            opcode: "if",
            operands: [condition]
        }
    }
    
    // Default: just a value
    return Instruction {
        opcode: "const",
        operands: [stmt]
    }
}

fn compile_instruction(instr: Instruction) -> [int] {
    match instr.opcode {
        "add" => {
            return [OP_LOCAL_GET, 0, OP_LOCAL_GET, 1, OP_I32_ADD]
        }
        "sub" => {
            return [OP_LOCAL_GET, 0, OP_LOCAL_GET, 1, OP_I32_SUB]
        }
        "mul" => {
            return [OP_LOCAL_GET, 0, OP_LOCAL_GET, 1, OP_I32_MUL]
        }
        "div" => {
            return [OP_LOCAL_GET, 0, OP_LOCAL_GET, 1, OP_I32_DIV_S]
        }
        "return" => {
            return [OP_RETURN]
        }
        "if" => {
            return [OP_IF, OP_END]
        }
        "const" => {
            let value = instr.operands[0]
            if value.to_int() != 0 || value == "0" {
                return [OP_I32_CONST, value.to_int()]
            }
            return []
        }
        _ => {
            return []
        }
    }
}

fn generate_wasm_bytecode(module: WASMModule) -> [int] {
    let bytecode = []
    
    // Magic number and version
    bytecode = bytecode + [0x00, 0x61, 0x73, 0x6D] // \0asm
    bytecode = bytecode + [0x01, 0x00, 0x00, 0x00] // version 1
    
    // Type section
    bytecode = bytecode + [0x01] // section id
    bytecode = bytecode + encode_leb128(module.types.len)
    for type in module.types {
        bytecode = bytecode + [0x60] // func type
        bytecode = bytecode + encode_leb128(type.params.len)
        for param in type.params {
            bytecode = bytecode + encode_val_type(param)
        }
        bytecode = bytecode + encode_leb128(type.results.len)
        for result in type.results {
            bytecode = bytecode + encode_val_type(result)
        }
    }
    
    // Function section
    bytecode = bytecode + [0x03] // section id
    bytecode = bytecode + encode_leb128(module.functions.len)
    for func in module.functions {
        bytecode = bytecode + [func.type_index]
    }
    
    // Export section
    bytecode = bytecode + [0x07] // section id
    bytecode = bytecode + encode_leb128(module.exports.len)
    for export in module.exports {
        bytecode = bytecode + encode_leb128(export.name.len)
        for c in export.name {
            bytecode = bytecode + c.to_int()
        }
        bytecode = bytecode + [0x00] // string kind
        bytecode = bytecode + [0x03] // func kind
        bytecode = bytecode + encode_leb128(export.index)
    }
    
    // Code section
    bytecode = bytecode + [0x0A] // section id
    bytecode = bytecode + encode_leb128(module.functions.len)
    for func in module.functions {
        bytecode = bytecode + encode_leb128(func.body.len)
        bytecode = bytecode + func.body
    }
    
    return bytecode
}

fn encode_leb128(value: int) -> [int] {
    let bytes = []
    let v = value
    
    loop {
        let byte = v & 0x7F
        v = v >> 7
        if v > 0 {
            byte = byte | 0x80
        }
        bytes.push(byte)
        
        if v == 0 {
            break
        }
    }
    
    return bytes
}

fn encode_val_type(type_str: string) -> int {
    match type_str {
        "i32" => return 0x7F
        "i64" => return 0x7E
        "f32" => return 0x7D
        "f64" => return 0x7C
        _ => return 0x7F
    }
}

fn write_wasm_file(module: WASMModule, path: string) {
    let bytecode = module.code
    
    let data = ""
    for byte in bytecode {
        data = data + byte.to_char()
    }
    
    fs.write_file(path, data)
}

fn generate_html_wrapper(module: WASMModule, wasm_path: string) -> string {
    let html = "<!DOCTYPE html>\n"
    html = html + "<html>\n"
    html = html + "<head>\n"
    html = html + "    <title>SEED WebAssembly</title>\n"
    html = html + "</head>\n"
    html = html + "<body>\n"
    html = html + "    <h1>SEED WebAssembly</h1>\n"
    html = html + "    <script>\n"
    html = html + "        (async () => {\n"
    html = html + "            const response = await fetch('" + wasm_path + "');\n"
    html = html + "            const bytes = await response.arrayBuffer();\n"
    html = html + "            const module = await WebAssembly.instantiate(bytes);\n"
    html = html + "            const instance = module.instance;\n"
    
    for export in module.exports {
        if export.kind == "function" {
            html = html + "            console.log('" + export.name + ":', instance.exports." + export.name + "());\n"
        }
    }
    
    html = html + "        })();\n"
    html = html + "    </script>\n"
    html = html + "</body>\n"
    html = html + "</html>\n"
    
    return html
}

fn write_html_wrapper(html: string, path: string) {
    fs.write_file(path, html)
}

// Main compilation function
fn compile_seed_to_wasm(seed_file: string, output_dir: string) {
    println("Compilando " + seed_file + " para WebAssembly...")
    
    let source = fs.read_file(seed_file)
    let module = compile_to_wasm(source)
    
    let wasm_path = output_dir + "\\" + fs.basename(seed_file).replace(".seed", ".wasm")
    let html_path = output_dir + "\\" + fs.basename(seed_file).replace(".seed", ".html")
    
    write_wasm_file(module, wasm_path)
    println("✓ " + wasm_path)
    
    let html = generate_html_wrapper(module, fs.basename(wasm_path))
    write_html_wrapper(html, html_path)
    println("✓ " + html_path)
    
    println("Compilação concluída!")
}

fn main(args: [string]) {
    if args.len == 0 {
        println("Uso: seed wasm_compiler <arquivo.seed> [output_dir]")
        return
    }
    
    let seed_file = args[0]
    let output_dir = if args.len > 1 { args[1] } else { "." }
    
    compile_seed_to_wasm(seed_file, output_dir)
}
