
// Simple "Guess the Number" game in SEED language
// The program picks a random number between 1 and 100 and asks the user to guess.
// It replies with "Too high", "Too low" or "Correct!" and counts attempts.

import std.io;
import std.math;
import std.rand;

fn main() -> Result {
    // Generate secret number
    let secret = rand::int_range(1, 100);
    let mut attempts: i32 = 0;
    io::println("=== Guess the Number ===");
    loop {
        io::print("Enter your guess (1-100): ");
        let guess_str = io::read_line();
        // Parse integer, handling invalid input
        match guess_str.trim().parse::<i32>() {
            Ok(guess) => {
                attempts = attempts + 1;
                if guess < secret {
                    io::println("Too low!");
                } else if guess > secret {
                io::println("Too high!");
            } else {
            io::println("Correct! You guessed in " + attempts.to_string() + " attempts.");
            break;
        }
}
Err(_) => {
    io::println("Please enter a valid number.");
}
}
}
return Result::Ok;
}
