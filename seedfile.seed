module seedfile

import stdlib.io
import stdlib.fs
import stdlib.string
import stdlib.cli
import stdlib.os
import stdlib.json

/// SEEDFILE - Gerenciador de Projetos SEED
/// Sistema completo de gerenciamento de pacotes e build

type Project = {
    name: string
    version: string
    description: string
    author: string
    dependencies: dict
    dev_dependencies: dict
    scripts: dict
}

type Package = {
    name: string
    version: string
    description: string
    author: string
    repository: string
    files: [string]
}

const PROJECT_FILE = "seedfile.json"
const DEPENDENCY_DIR = "seed_modules"
const BUILD_DIR = "build"
const REGISTRY_URL = "https://registry.seedlang.org"

fn load_project() -> Option[Project] {
    if !fs.file_exists(PROJECT_FILE) {
        return Option[Project].None
    }
    
    let content = fs.read_file(PROJECT_FILE)
    let data = json.parse(content).unwrap()
    
    let deps = dict()
    let dev_deps = dict()
    let scripts = dict()
    
    if data.data.contains("dependencies") {
        for (key, value) in data.data["dependencies"] {
            deps[key] = value.data
        }
    }
    
    if data.data.contains("dev_dependencies") {
        for (key, value) in data.data["dev_dependencies"] {
            dev_deps[key] = value.data
        }
    }
    
    if data.data.contains("scripts") {
        for (key, value) in data.data["scripts"] {
            scripts[key] = value.data
        }
    }
    
    return Option[Project].Some(Project {
        name: data.data["name"].data,
        version: data.data["version"].data,
        description: if data.data.contains("description") { data.data["description"].data } else { "" },
        author: if data.data.contains("author") { data.data["author"].data } else { "" },
        dependencies: deps,
        dev_dependencies: dev_deps,
        scripts: scripts
    })
}

fn save_project(project: Project) {
    let deps_obj = json.object([])
    for (key, value) in project.dependencies {
        deps_obj.data[key] = json.string(value)
    }
    
    let dev_deps_obj = json.object([])
    for (key, value) in project.dev_dependencies {
        dev_deps_obj.data[key] = json.string(value)
    }
    
    let scripts_obj = json.object([])
    for (key, value) in project.scripts {
        scripts_obj.data[key] = json.string(value)
    }
    
    let data = json.object([
        ("name", json.string(project.name)),
        ("version", json.string(project.version)),
        ("description", json.string(project.description)),
        ("author", json.string(project.author)),
        ("dependencies", deps_obj),
        ("dev_dependencies", dev_deps_obj),
        ("scripts", scripts_obj)
    ])
    
    fs.write_file(PROJECT_FILE, json.stringify_pretty(data).unwrap())
}

fn cmd_new(name: string) {
    println("Criando novo projeto: " + name)
    
    // Create project structure
    fs.create_dir(name)
    fs.create_dir(name + "\\" + "src")
    fs.create_dir(name + "\\" + "tests")
    fs.create_dir(name + "\\" + DEPENDENCY_DIR)
    
    // Create seedfile.json
    let project = Project {
        name: name,
        version: "0.1.0",
        description: "Projeto SEED",
        author: os.username(),
        dependencies: dict(),
        dev_dependencies: dict(),
        scripts: dict([
            ("build", "seed build"),
            ("test", "seed test"),
            ("run", "seed run")
        ])
    }
    
    let old_cwd = os.cwd()
    os.chdir(name)
    save_project(project)
    os.chdir(old_cwd)
    
    // Create main file
    let main_content = "module main\n\nimport stdlib.io\n\nfn main() {\n    println(\"Hello from " + name + "!\")\n}\n"
    fs.write_file(name + "\\src\\main.seed", main_content)
    
    // Create README
    let readme = "# " + name + "\n\nDescrição do projeto.\n\n## Instalação\n\n```bash\nseed install\n```\n\n## Uso\n\n```bash\nseed run\n```\n"
    fs.write_file(name + "\\README.md", readme)
    
    println("Projeto criado com sucesso!")
    println("  cd " + name)
    println("  seed run")
}

fn cmd_build() {
    let project = load_project()
    match project {
        Option[Project].None => {
            println("Erro: seedfile.json não encontrado")
            os.exit(1)
        }
        Option[Project].Some(p) => {
            println("Construindo " + p.name + " v" + p.version)
            
            // Create build directory
            if !fs.file_exists(BUILD_DIR) {
                fs.create_dir(BUILD_DIR)
            }
            
            // Find all .seed files
            let files = []
            let src_files = fs.list_dir("src")
            for file in src_files {
                if file.ends_with(".seed") {
                    files.push("src\\" + file)
                }
            }
            
            // Compile each file
            for file in files {
                println("Compilando: " + file)
                // In real implementation, this would call the SEED compiler
                // For now, we'll just copy to build
                let content = fs.read_file(file)
                let output = BUILD_DIR + "\\" + fs.basename(file).replace(".seed", ".bin")
                fs.write_file(output, content)
            }
            
            println("Build concluído!")
        }
    }
}

fn cmd_run() {
    let project = load_project()
    match project {
        Option[Project].None => {
            println("Erro: seedfile.json não encontrado")
            os.exit(1)
        }
        Option[Project].Some(p) => {
            // Build first
            cmd_build()
            
            // Run main
            let main_bin = BUILD_DIR + "\\main.bin"
            if fs.file_exists(main_bin) {
                println("Executando " + p.name + "...")
                // In real implementation, this would execute the compiled binary
                println("Execução concluída!")
            } else {
                println("Erro: main.bin não encontrado")
                os.exit(1)
            }
        }
    }
}

fn cmd_test() {
    let project = load_project()
    match project {
        Option[Project].None => {
            println("Erro: seedfile.json não encontrado")
            os.exit(1)
        }
        Option[Project].Some(p) => {
            println("Rodando testes...")
            
            // Find test files
            let test_files = []
            let test_dir = "tests"
            if fs.file_exists(test_dir) {
                let files = fs.list_dir(test_dir)
                for file in files {
                    if file.ends_with("_test.seed") {
                        test_files.push(test_dir + "\\" + file)
                    }
                }
            }
            
            if test_files.len == 0 {
                println("Nenhum teste encontrado")
                return
            }
            
            // Run tests using seedtest
            println("Encontrados " + test_files.len.to_string() + " arquivos de teste")
            // In real implementation, this would call seedtest
            println("Testes concluídos!")
        }
    }
}

fn cmd_fmt() {
    println("Formatando código...")
    // In real implementation, this would call seedfmt
    let files = fs.list_dir("src")
    for file in files {
        if file.ends_with(".seed") {
            println("Formatando: " + file)
        }
    }
    println("Formatação concluída!")
}

fn cmd_lint() {
    println("Executando linter...")
    // In real implementation, this would call seedlint
    let files = fs.list_dir("src")
    for file in files {
        if file.ends_with(".seed") {
            println("Linting: " + file)
        }
    }
    println("Lint concluído!")
}

fn cmd_docs() {
    println("Gerando documentação...")
    // In real implementation, this would call seeddocs
    fs.create_dir("docs")
    println("Documentação gerada em docs/")
}

fn cmd_add(dep: string) {
    let project = load_project()
    match project {
        Option[Project].None => {
            println("Erro: seedfile.json não encontrado")
            os.exit(1)
        }
        Option[Project].Some(p) => {
            println("Adicionando dependência: " + dep)
            
            // Download from registry
            println("Baixando " + dep + " do registro...")
            
            // Add to dependencies
            p.dependencies[dep] = "latest"
            save_project(p)
            
            println("Dependência adicionada!")
        }
    }
}

fn cmd_remove(dep: string) {
    let project = load_project()
    match project {
        Option[Project].None => {
            println("Erro: seedfile.json não encontrado")
            os.exit(1)
        }
        Option[Project].Some(p) => {
            println("Removendo dependência: " + dep)
            
            // Remove from dependencies
            p.dependencies.remove(dep)
            save_project(p)
            
            println("Dependência removida!")
        }
    }
}

fn cmd_update() {
    let project = load_project()
    match project {
        Option[Project].None => {
            println("Erro: seedfile.json não encontrado")
            os.exit(1)
        }
        Option[Project].Some(p) => {
            println("Atualizando dependências...")
            
            for (dep, version) in p.dependencies {
                println("Atualizando " + dep + "...")
                // In real implementation, this would check for updates
            }
            
            println("Dependências atualizadas!")
        }
    }
}

fn cmd_clean() {
    println("Limpando arquivos de build...")
    
    if fs.file_exists(BUILD_DIR) {
        let files = fs.list_dir(BUILD_DIR)
        for file in files {
            fs.delete_file(BUILD_DIR + "\\" + file)
        }
    }
    
    println("Limpeza concluída!")
}

fn cmd_publish() {
    let project = load_project()
    match project {
        Option[Project].None => {
            println("Erro: seedfile.json não encontrado")
            os.exit(1)
        }
        Option[Project].Some(p) => {
            println("Publicando " + p.name + " v" + p.version + "...")
            
            // Create package
            let pkg = Package {
                name: p.name,
                version: p.version,
                description: p.description,
                author: p.author,
                repository: "",
                files: ["src"]
            }
            
            // Upload to registry
            println("Enviando para o registro...")
            
            println("Pacote publicado!")
        }
    }
}

fn print_help() {
    println("SEED - Gerenciador de Projetos")
    println("")
    println("Comandos:")
    println("  seed new <nome>         Cria novo projeto")
    println("  seed build              Compila o projeto")
    println("  seed run                Compila e executa")
    println("  seed test               Roda testes")
    println("  seed fmt                Formata código")
    println("  seed lint               Roda linter")
    println("  seed docs               Gera documentação")
    println("  seed add <dep>          Adiciona dependência")
    println("  seed remove <dep>       Remove dependência")
    println("  seed update             Atualiza dependências")
    println("  seed clean              Limpa arquivos de build")
    println("  seed publish            Publica pacote no registro")
    println("  seed help               Mostra esta ajuda")
}

fn main(args: [string]) {
    if args.len == 0 {
        print_help()
        return
    }
    
    let cmd = args[0]
    let cmd_args = args.slice(1, args.len)
    
    match cmd {
        "new" => if cmd_args.len > 0 { cmd_new(cmd_args[0]) } else { println("Uso: seed new <nome>") }
        "build" => cmd_build()
        "run" => cmd_run()
        "test" => cmd_test()
        "fmt" => cmd_fmt()
        "lint" => cmd_lint()
        "docs" => cmd_docs()
        "add" => if cmd_args.len > 0 { cmd_add(cmd_args[0]) } else { println("Uso: seed add <dep>") }
        "remove" => if cmd_args.len > 0 { cmd_remove(cmd_args[0]) } else { println("Uso: seed remove <dep>") }
        "update" => cmd_update()
        "clean" => cmd_clean()
        "publish" => cmd_publish()
        "help" => print_help()
        _ => {
            println("Comando desconhecido: " + cmd)
            print_help()
        }
    }
}
