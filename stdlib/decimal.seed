module stdlib.decimal

/// Decimal arithmetic module for precise financial calculations

pub type Decimal = {
    value: int,
    scale: int
}

pub fn from_int(n: int) -> Decimal {
    return Decimal { value: n, scale: 0 }
}

pub fn from_float(f: float) -> Decimal {
    return syscall.decimal_from_float(f)
}

pub fn from_string(s: string) -> Result<Decimal, string> {
    return syscall.decimal_from_string(s)
}

pub fn to_string(d: Decimal) -> string {
    return syscall.decimal_to_string(d)
}

pub fn to_float(d: Decimal) -> float {
    return syscall.decimal_to_float(d)
}

pub fn add(a: Decimal, b: Decimal) -> Decimal {
    return syscall.decimal_add(a, b)
}

pub fn sub(a: Decimal, b: Decimal) -> Decimal {
    return syscall.decimal_sub(a, b)
}

pub fn mul(a: Decimal, b: Decimal) -> Decimal {
    return syscall.decimal_mul(a, b)
}

pub fn div(a: Decimal, b: Decimal) -> Result<Decimal, string> {
    return syscall.decimal_div(a, b)
}

pub fn mod(a: Decimal, b: Decimal) -> Decimal {
    return syscall.decimal_mod(a, b)
}

pub fn round(d: Decimal, places: int) -> Decimal {
    return syscall.decimal_round(d, places)
}

pub fn ceil(d: Decimal) -> Decimal {
    return syscall.decimal_ceil(d)
}

pub fn floor(d: Decimal) -> Decimal {
    return syscall.decimal_floor(d)
}

pub fn abs(d: Decimal) -> Decimal {
    if d.value < 0 {
        return Decimal { value: -d.value, scale: d.scale }
    }
    return d
}

pub fn compare(a: Decimal, b: Decimal) -> int {
    return syscall.decimal_compare(a, b)
}

pub fn eq(a: Decimal, b: Decimal) -> bool {
    return compare(a, b) == 0
}

pub fn ne(a: Decimal, b: Decimal) -> bool {
    return compare(a, b) != 0
}

pub fn lt(a: Decimal, b: Decimal) -> bool {
    return compare(a, b) < 0
}

pub fn le(a: Decimal, b: Decimal) -> bool {
    return compare(a, b) <= 0
}

pub fn gt(a: Decimal, b: Decimal) -> bool {
    return compare(a, b) > 0
}

pub fn ge(a: Decimal, b: Decimal) -> bool {
    return compare(a, b) >= 0
}

pub fn min(a: Decimal, b: Decimal) -> Decimal {
    if lt(a, b) { return a } else { return b }
}

pub fn max(a: Decimal, b: Decimal) -> Decimal {
    if gt(a, b) { return a } else { return b }
}
