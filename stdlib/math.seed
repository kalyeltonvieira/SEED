module stdlib.math

/// Mathematical functions module

pub const PI: float = 3.141592653589793
pub const E: float = 2.718281828459045
pub const TAU: float = 6.283185307179586

pub fn abs(x: float) -> float {
    if x < 0 { return -x } else { return x }
}

pub fn sqrt(x: float) -> float {
    return syscall.math_sqrt(x)
}

pub fn pow(base: float, exp: float) -> float {
    return syscall.math_pow(base, exp)
}

pub fn sin(x: float) -> float {
    return syscall.math_sin(x)
}

pub fn cos(x: float) -> float {
    return syscall.math_cos(x)
}

pub fn tan(x: float) -> float {
    return syscall.math_tan(x)
}

pub fn asin(x: float) -> float {
    return syscall.math_asin(x)
}

pub fn acos(x: float) -> float {
    return syscall.math_acos(x)
}

pub fn atan(x: float) -> float {
    return syscall.math_atan(x)
}

pub fn atan2(y: float, x: float) -> float {
    return syscall.math_atan2(y, x)
}

pub fn log(x: float) -> float {
    return syscall.math_log(x)
}

pub fn log2(x: float) -> float {
    return syscall.math_log2(x)
}

pub fn log10(x: float) -> float {
    return syscall.math_log10(x)
}

pub fn ln(x: float) -> float {
    return syscall.math_log(x)
}

pub fn exp(x: float) -> float {
    return syscall.math_exp(x)
}

pub fn ceil(x: float) -> int {
    return syscall.math_ceil(x)
}

pub fn floor(x: float) -> int {
    return syscall.math_floor(x)
}

pub fn round(x: float) -> int {
    return syscall.math_round(x)
}

pub fn min(a: float, b: float) -> float {
    if a < b { return a } else { return b }
}

pub fn max(a: float, b: float) -> float {
    if a > b { return a } else { return b }
}

pub fn clamp(x: float, min_val: float, max_val: float) -> float {
    return min(max(x, min_val), max_val)
}

pub fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

pub fn degrees(rad: float) -> float {
    return rad * 180.0 / PI
}

pub fn radians(deg: float) -> float {
    return deg * PI / 180.0
}

pub fn hypot(x: float, y: float) -> float {
    return sqrt(x * x + y * y)
}
