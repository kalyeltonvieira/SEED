module stdlib.ansi

/// ANSI escape code utility module for terminal styling

pub const RESET: string = "\033[0m"
pub const BOLD: string = "\033[1m"
pub const DIM: string = "\033[2m"
pub const ITALIC: string = "\033[3m"
pub const UNDERLINE: string = "\033[4m"
pub const BLINK: string = "\033[5m"
pub const REVERSE: string = "\033[7m"
pub const HIDDEN: string = "\033[8m"

// Foreground colors
pub const BLACK: string = "\033[30m"
pub const RED: string = "\033[31m"
pub const GREEN: string = "\033[32m"
pub const YELLOW: string = "\033[33m"
pub const BLUE: string = "\033[34m"
pub const MAGENTA: string = "\033[35m"
pub const CYAN: string = "\033[36m"
pub const WHITE: string = "\033[37m"

// Background colors
pub const BG_BLACK: string = "\033[40m"
pub const BG_RED: string = "\033[41m"
pub const BG_GREEN: string = "\033[42m"
pub const BG_YELLOW: string = "\033[43m"
pub const BG_BLUE: string = "\033[44m"
pub const BG_MAGENTA: string = "\033[45m"
pub const BG_CYAN: string = "\033[46m"
pub const BG_WHITE: string = "\033[47m"

pub fn style(text: string, style_code: string) -> string {
    return style_code + text + RESET
}

pub fn cursor_up(n: int) -> string {
    return "\033[" + n.to_string() + "A"
}

pub fn cursor_down(n: int) -> string {
    return "\033[" + n.to_string() + "B"
}

pub fn cursor_forward(n: int) -> string {
    return "\033[" + n.to_string() + "C"
}

pub fn cursor_back(n: int) -> string {
    return "\033[" + n.to_string() + "D"
}

pub fn clear_screen() -> string {
    return "\033[2J\033[H"
}

pub fn clear_line() -> string {
    return "\033[2K"
}
