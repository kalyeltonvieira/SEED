module compiler.lexer

/// Analisador Léxico para SEED
/// Transforma texto bruto em tokens com suporte UTF-8 completo

type TokenType = {
    name: string
    value: string
}

type Token = {
    type: TokenType
    lexeme: string
    line: int
    column: int
    position: int
}

type Lexer = {
    source: string
    position: int
    line: int
    column: int
    tokens: [Token]
    errors: [string]
}

// Tipos de token
const IDENTIFIER = TokenType { name: "IDENTIFIER", value: "" }
const KEYWORD = TokenType { name: "KEYWORD", value: "" }
const NUMBER = TokenType { name: "NUMBER", value: "" }
const STRING = TokenType { name: "STRING", value: "" }
const CHAR = TokenType { name: "CHAR", value: "" }
const OPERATOR = TokenType { name: "OPERATOR", value: "" }
const DELIMITER = TokenType { name: "DELIMITER", value: "" }
const COMMENT = TokenType { name: "COMMENT", value: "" }
const WHITESPACE = TokenType { name: "WHITESPACE", value: "" }
const EOF = TokenType { name: "EOF", value: "" }

// Palavras-chave
const KEYWORDS = [
    "fn", "let", "const", "if", "else", "for", "while", "return",
    "match", "case", "type", "enum", "data", "import", "module",
    "async", "await", "effect", "deny", "true", "false", "null",
    "struct", "trait", "impl", "where", "use", "pub", "priv"
]

fn lexer(source: string) -> Lexer {
    return Lexer {
        source: source,
        position: 0,
        line: 1,
        column: 1,
        tokens: [],
        errors: []
    }
}

fn lex(lexer: Lexer) -> [Token] {
    while lexer.position < lexer.source.len {
        let c = peek(lexer)
        
        if is_whitespace(c) {
            skip_whitespace(lexer)
        } else if c == "/" && peek_next(lexer) == "/" {
            skip_line_comment(lexer)
        } else if c == "/" && peek_next(lexer) == "*" {
            skip_block_comment(lexer)
        } else if is_alpha(c) || c == "_" {
            lex_identifier(lexer)
        } else if is_digit(c) {
            lex_number(lexer)
        } else if c == "\"" {
            lex_string(lexer)
        } else if c == "'" {
            lex_char(lexer)
        } else if is_operator_start(c) {
            lex_operator(lexer)
        } else if is_delimiter(c) {
            lex_delimiter(lexer)
        } else {
            error(lexer, "Caractere desconhecido: " + c)
            advance(lexer)
        }
    }
    
    lexer.tokens.push(Token {
        type: EOF,
        lexeme: "",
        line: lexer.line,
        column: lexer.column,
        position: lexer.position
    })
    
    return lexer.tokens
}

fn peek(lexer: Lexer) -> string {
    if lexer.position >= lexer.source.len {
        return ""
    }
    return lexer.source[lexer.position]
}

fn peek_next(lexer: Lexer) -> string {
    if lexer.position + 1 >= lexer.source.len {
        return ""
    }
    return lexer.source[lexer.position + 1]
}

fn advance(lexer: Lexer) {
    if lexer.position < lexer.source.len {
        let c = lexer.source[lexer.position]
        if c == "\n" {
            lexer.line = lexer.line + 1
            lexer.column = 1
        } else {
            lexer.column = lexer.column + 1
        }
        lexer.position = lexer.position + 1
    }
}

fn skip_whitespace(lexer: Lexer) {
    while lexer.position < lexer.source.len && is_whitespace(peek(lexer)) {
        advance(lexer)
    }
}

fn skip_line_comment(lexer: Lexer) {
    while lexer.position < lexer.source.len && peek(lexer) != "\n" {
        advance(lexer)
    }
}

fn skip_block_comment(lexer: Lexer) {
    advance(lexer) // Skip /
    advance(lexer) // Skip *
    
    while lexer.position < lexer.source.len {
        if peek(lexer) == "*" && peek_next(lexer) == "/" {
            advance(lexer) // Skip *
            advance(lexer) // Skip /
            return
        }
        advance(lexer)
    }
    
    error(lexer, "Comentário de bloco não fechado")
}

fn lex_identifier(lexer: Lexer) {
    let start = lexer.position
    let start_line = lexer.line
    let start_column = lexer.column
    
    while lexer.position < lexer.source.len && (is_alpha_numeric(peek(lexer)) || peek(lexer) == "_") {
        advance(lexer)
    }
    
    let lexeme = lexer.source.substring(start, lexer.position)
    
    let token_type = if KEYWORDS.contains(lexeme) { KEYWORD } else { IDENTIFIER }
    
    lexer.tokens.push(Token {
        type: token_type,
        lexeme: lexeme,
        line: start_line,
        column: start_column,
        position: start
    })
}

fn lex_number(lexer: Lexer) {
    let start = lexer.position
    let start_line = lexer.line
    let start_column = lexer.column
    
    // Parte inteira
    while lexer.position < lexer.source.len && is_digit(peek(lexer)) {
        advance(lexer)
    }
    
    // Parte decimal
    if peek(lexer) == "." {
        advance(lexer)
        while lexer.position < lexer.source.len && is_digit(peek(lexer)) {
            advance(lexer)
        }
    }
    
    // Expoente
    if peek(lexer) == "e" || peek(lexer) == "E" {
        advance(lexer)
        if peek(lexer) == "+" || peek(lexer) == "-" {
            advance(lexer)
        }
        while lexer.position < lexer.source.len && is_digit(peek(lexer)) {
            advance(lexer)
        }
    }
    
    let lexeme = lexer.source.substring(start, lexer.position)
    
    lexer.tokens.push(Token {
        type: NUMBER,
        lexeme: lexeme,
        line: start_line,
        column: start_column,
        position: start
    })
}

fn lex_string(lexer: Lexer) {
    let start = lexer.position
    let start_line = lexer.line
    let start_column = lexer.column
    
    advance(lexer) // Skip "
    
    while lexer.position < lexer.source.len && peek(lexer) != "\"" {
        if peek(lexer) == "\\" {
            advance(lexer) // Skip \
        }
        advance(lexer)
    }
    
    if lexer.position >= lexer.source.len {
        error(lexer, "String não fechada")
        return
    }
    
    advance(lexer) // Skip "
    
    let lexeme = lexer.source.substring(start, lexer.position)
    
    lexer.tokens.push(Token {
        type: STRING,
        lexeme: lexeme,
        line: start_line,
        column: start_column,
        position: start
    })
}

fn lex_char(lexer: Lexer) {
    let start = lexer.position
    let start_line = lexer.line
    let start_column = lexer.column
    
    advance(lexer) // Skip '
    
    if peek(lexer) == "\\" {
        advance(lexer) // Skip \
    }
    
    advance(lexer) // Skip character
    
    if lexer.position >= lexer.source.len || peek(lexer) != "'" {
        error(lexer, "Char não fechado")
        return
    }
    
    advance(lexer) // Skip '
    
    let lexeme = lexer.source.substring(start, lexer.position)
    
    lexer.tokens.push(Token {
        type: CHAR,
        lexeme: lexeme,
        line: start_line,
        column: start_column,
        position: start
    })
}

fn lex_operator(lexer: Lexer) {
    let start = lexer.position
    let start_line = lexer.line
    let start_column = lexer.column
    
    let c = peek(lexer)
    let next = peek_next(lexer)
    
    // Operadores de dois caracteres
    if (c == "=" && next == "=") ||
       (c == "!" && next == "=") ||
       (c == "<" && next == "=") ||
       (c == ">" && next == "=") ||
       (c == "+" && next == "+") ||
       (c == "-" && next == "-") ||
       (c == "+" && next == "=") ||
       (c == "-" && next == "=") ||
       (c == "*" && next == "=") ||
       (c == "/" && next == "=") ||
       (c == "%" && next == "=") ||
       (c == "&" && next == "&") ||
       (c == "|" && next == "|") ||
       (c == "-" && next == ">") ||
       (c == "=" && next == ">") {
        advance(lexer)
        advance(lexer)
    } else {
        advance(lexer)
    }
    
    let lexeme = lexer.source.substring(start, lexer.position)
    
    lexer.tokens.push(Token {
        type: OPERATOR,
        lexeme: lexeme,
        line: start_line,
        column: start_column,
        position: start
    })
}

fn lex_delimiter(lexer: Lexer) {
    let start = lexer.position
    let start_line = lexer.line
    let start_column = lexer.column
    
    advance(lexer)
    
    let lexeme = lexer.source.substring(start, lexer.position)
    
    lexer.tokens.push(Token {
        type: DELIMITER,
        lexeme: lexeme,
        line: start_line,
        column: start_column,
        position: start
    })
}

fn error(lexer: Lexer, message: string) {
    let error_msg = "Erro léxico na linha " + lexer.line.to_string() + ", coluna " + lexer.column.to_string() + ": " + message
    lexer.errors.push(error_msg)
}

// Funções auxiliares
fn is_whitespace(c: string) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r"
}

fn is_alpha(c: string) -> bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
}

fn is_digit(c: string) -> bool {
    return c >= "0" && c <= "9"
}

fn is_alpha_numeric(c: string) -> bool {
    return is_alpha(c) || is_digit(c)
}

fn is_operator_start(c: string) -> bool {
    return c == "+" || c == "-" || c == "*" || c == "/" || c == "%" ||
           c == "=" || c == "!" || c == "<" || c == ">" || c == "&" ||
           c == "|" || c == "^" || c == "~" || c == "?" || c == ":"
}

fn is_delimiter(c: string) -> bool {
    return c == "(" || c == ")" || c == "{" || c == "}" || c == "[" || c == "]" ||
           c == "," || c == ";" || c == "." || c == ":" || c == "::"
}

// UTF-8 support
fn is_utf8_continuation(byte: int) -> bool {
    return (byte & 0xC0) == 0x80
}

fn utf8_char_length(first_byte: int) -> int {
    if (first_byte & 0x80) == 0x00 {
        return 1
    } else if (first_byte & 0xE0) == 0xC0 {
        return 2
    } else if (first_byte & 0xF0) == 0xE0 {
        return 3
    } else if (first_byte & 0xF8) == 0xF0 {
        return 4
    }
    return 1
}

fn read_utf8_char(lexer: Lexer) -> string {
    let first_byte = peek(lexer).to_int()
    let length = utf8_char_length(first_byte)
    
    let char_bytes = []
    char_bytes.push(first_byte)
    
    for i in 1..length {
        advance(lexer)
        char_bytes.push(peek(lexer).to_int())
    }
    
    // Convert bytes to string (simplified)
    let result = ""
    for byte in char_bytes {
        result = result + byte.to_char()
    }
    
    return result
}

// Token filtering
fn filter_comments(tokens: [Token]) -> [Token] {
    return tokens.filter(t => t.type.name != "COMMENT" && t.type.name != "WHITESPACE")
}

fn filter_whitespace(tokens: [Token]) -> [Token] {
    return tokens.filter(t => t.type.name != "WHITESPACE")
}

// Token inspection
fn get_token_at(tokens: [Token], position: int) -> Option[Token] {
    if position >= 0 && position < tokens.len {
        return Option[Token].Some(tokens[position])
    }
    return Option[Token].None
}

fn find_token(tokens: [Token], lexeme: string) -> int {
    for i in 0..tokens.len {
        if tokens[i].lexeme == lexeme {
            return i
        }
    }
    return -1
}

fn token_to_string(token: Token) -> string {
    return token.type.name + "(" + token.lexeme + ") @ " + token.line.to_string() + ":" + token.column.to_string()
}

// Main lexing function
fn tokenize(source: string) -> ([Token], [string]) {
    let l = lexer(source)
    let tokens = lex(l)
    
    if l.errors.len > 0 {
        return (tokens, l.errors)
    }
    
    return (filter_comments(tokens), [])
}
