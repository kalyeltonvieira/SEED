fn test_errors() {
    println("Testando erros de parsing...")
    
    let source = "fn main() { }"  // Função sem corpo
    let (tokens, errors) = lexer.tokenize(source)
    
    if errors.len > 0 {
        println("  [FALHOU] Erros léxicos inesperados: " + errors.join(", "))
        exit(1)
    }
    
    let ast_result = parser.parse(tokens)
    // Esperado que o parser detecte o erro
    
    println("  [OK]")
}
