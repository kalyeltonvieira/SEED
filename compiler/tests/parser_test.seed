module compiler.tests.parser_test

/// Testes do Parser SEED
/// Verifica se o parser constrói corretamente a AST

use compiler.lexer
use compiler.parser

fn main() {
    println("=== Testes do Parser SEED ===")
    println("")
    
    test_function_declaration()
    test_variable_declaration()
    test_if_expression()
    test_while_loop()
    test_for_loop()
    test_match_expression()
    test_binary_operations()
    test_function_call()
    test_errors()
    
    println("")
    println("Todos os testes do parser passaram!")
}

fn test_function_declaration() {
    println("Testando declaração de função...")
    
    let source = "fn main() { println(\"hello\") }"
    let (tokens, errors) = lexer.tokenize(source)
    
    if errors.len > 0 {
        println("  [FALHOU] Erros léxicos: " + errors.join(", "))
        exit(1)
    }
    
    let ast_result = parser.parse(tokens)
    if ast_result.is_error {
        println("  [FALHOU] Erro de parsing: " + ast_result.error)
        exit(1)
    }
    
    let ast = ast_result.value
    if ast.declarations.len != 1 {
        println("  [FALHOU] Esperado 1 declaração, obteve " + ast.declarations.len.to_string())
        exit(1)
    }
    
    println("  [OK]")
}

