module compiler.tests.codegen_test

/// Testes do Codegen SEED
/// Verifica se o codegen gera bytecode corretamente

use compiler.lexer
use compiler.parser
use compiler.typechecker
use compiler.codegen

fn main() {
    println("=== Testes do Codegen SEED ===")
    println("")
    
    test_constant_generation()
    test_variable_allocation()
    test_function_call()
    test_binary_operations()
    test_control_flow()
    test_stack_management()
    
    println("")
    println("Todos os testes do codegen passaram!")
}

fn test_constant_generation() {
    println("Testando geração de constantes...")
    
    let source = "fn main() { let x = 42 }"
    let (tokens, errors) = lexer.tokenize(source)
    
    if errors.len > 0 {
        println("  [FALHOU] Erros léxicos: " + errors.join(", "))
        exit(1)
    }
    
    let ast_result = parser.parse(tokens)
    if ast_result.is_error {
        println("  [FALHOU] Erro de parsing: " + ast_result.error)
        exit(1)
    }
    
    let typed_result = typechecker.typecheck(ast_result.value)
    if typed_result.is_error {
        println("  [FALHOU] Erro de tipo: " + typed_result.error)
        exit(1)
    }
    
    let codegen_result = codegen.codegen(typed_result.value)
    if codegen_result.is_error {
        println("  [FALHOU] Erro de geração de código: " + codegen_result.error)
        exit(1)
    }
    
    let bytecode = codegen_result.value
    if bytecode.instructions.len == 0 {
        println("  [FALHOU] Nenhuma instrução gerada")
        exit(1)
    }
    
    println("  [OK]")
}

