fn test_functions() {
    println("Testando funções...")
    
    let source = "fn soma(a: int, b: int) -> int { a + b }\n\nfn main() { println(soma(10, 20)) }"
    let (tokens, errors) = lexer.tokenize(source)
    
    if errors.len > 0 {
        println("  [FALHOU] Erros léxicos: " + errors.join(", "))
        exit(1)
    }
    
    let ast_result = parser.parse(tokens)
    if ast_result.is_error {
