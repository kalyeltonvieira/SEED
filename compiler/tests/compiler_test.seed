module compiler.tests.compiler_test

/// Testes de Integração do Compilador SEED
/// Verifica se todas as fases funcionam juntas corretamente
.
use compiler.lexer
use compiler.parser
use compiler.typechecker
use compiler.codegen
use compiler.optimizer
use compiler.compiler

fn main() {
    println("=== Testes de Integração do Compilador SEED ===")
    println("")
    
    test_full_compilation()
    test_hello_world()
    test_arithmetic()
    test_functions()
    test_control_flow()
    test_optimization_levels()
    test_error_handling()
    
    println("")
    println("Todos os testes de integração passaram!")
}

fn test_full_compilation() {
    println("Testando compilação completa...")
    
    let source = "fn main() { println(\"hello\") }"
    let options = CompileOptions {
        optimize: false,
        debug: false,
        output: "test_output.seedc"
    }
    
    let result = compiler.compile_file("dummy.seed", options)
    if result.is_error {
        println("  [FALHOU] Erro de compilação: " + result.error)
        exit(1)
    }
    
    println("  [OK]")
}

fn test_hello_world() {
    println("Testando Hello World...")
    
    let source = "fn main() { println(\"Hello, World!\") }"
    let (tokens, errors) = lexer.tokenize(source)
    
    if errors.len > 0 {
        println("  [FALHOU] Erros léxicos: " + errors.join(", "))
        exit(1)
    }
    
    let ast_result = parser.parse(tokens)
    if ast_result.is_error {
        println("  [FALHOU] Erro de parsing: " + ast_result.error)
        exit(1)
    }
    
    let typed_result = typechecker.typecheck(ast_result.value)
    if typed_result.is_error {
        println("  [FALHOU] Erro de tipo: " + typed_result.error)
        exit(1)
    }
    
    let codegen_result = codegen.codegen(typed_result.value)
    if codegen_result.is_error {
        println("  [FALHOU] Erro de geração de código: " + codegen_result.error)
        exit(1)
    }
    
    println("  [OK]")
}

