// Análise de fluxo de controle
fn analyze_control_flow(bytecode: Bytecode) -> [int] {
    // Retorna lista de labels (pontos de entrada)
    let labels = []
    
    for i in 0..bytecode.instructions.len {
        let instr = bytecode.instructions[i]
        if instr.opcode == OP_JMP {
            labels.push(instr.operands[0])
        }
    }
    
    return labels
}

// Verificação se instrução é label
fn is_label(instruction: Instruction) -> bool {
    return instruction.opcode == 0
}

// Otimização de alocação
fn optimize_allocations(bytecode: Bytecode) -> Bytecode {
    let instructions = bytecode.instructions
    let optimized = []
    
    // Agrupar ALLOCs consecutivos
    let i = 0
    while i < instructions.len {
        let current = instructions[i]
        
        if current.opcode == OP_ALLOC {
            let total_size = current.operands[0]
            let j = i + 1
            
            while j < instructions.len && instructions[j].opcode == OP_ALLOC {
                total_size = total_size + instructions[j].operands[0]
                j = j + 1
            }
            
            // Substituir por um único ALLOC
            optimized.push(Instruction {
                opcode: OP_ALLOC,
                operands: [total_size],
                line: current.line
            })
            
            i = j
            continue
        }
        
        optimized.push(current)
        i = i + 1
    }
    
    return Bytecode {
        instructions: optimized,
        constants: bytecode.constants,
        debug_info: bytecode.debug_info
    }
}

// Estatísticas de otimização
type OptimizationStats = {
    peephole_removed: int
    constants_folded: int
    dead_code_removed: int
    functions_inlined: int
    tail_calls_optimized: int
}

fn get_optimization_stats(original: Bytecode, optimized: Bytecode) -> OptimizationStats {
    return OptimizationStats {
        peephole_removed: original.instructions.len - optimized.instructions.len,
        constants_folded: 0,
        dead_code_removed: 0,
        functions_inlined: 0,
        tail_calls_optimized: 0
    }
}

// Imprimir estatísticas
fn print_stats(stats: OptimizationStats) {
    println("Estatísticas de Otimização:")
    println("  Instruções removidas (peephole): " + stats.peephole_removed.to_string())
    println("  Constantes dobradas: " + stats.constants_folded.to_string())
    println("  Código morto removido: " + stats.dead_code_removed.to_string())
    println("  Funções inlined: " + stats.functions_inlined.to_string())
    println("  Tail calls otimizadas: " + stats.tail_calls_optimized.to_string())
}
