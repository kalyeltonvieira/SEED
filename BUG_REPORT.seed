// BUG #1: Match com tipos mistos (CRÍTICO)
// Arquivo: seed_compiler_codegen.cpp, linha 168-180
// Problema: Match traduzido para lambda anônima em vez de instrução switch
// Sintoma: "match" não preserva tipos, gera C++ inválido
data Bug1 {
    Descricao(String)
    Linha(Int)
    Severidade(String)
    Solucao(String)
}

fn bug1() -> Bug1 {
    return Bug1 {
        Descricao: "Parse de match simplesmente cria lambda vazia",
        Linha: 179,
        Severidade: "CRÍTICA",
        Solucao: "Implementar gerador de switch statement com type checking"
    }
}

/*
parse_expr() traduz:
    match op {
        "+" => a + b
        ...
    }

Para:
    [&](){ /* match */ return op; }()

❌ ERRADO: perde os cases e a lógica
✓ CORRETO: gerar switch(op) com cases tipados
*/

// BUG #2: Type inference incompleta em expressões
// Arquivo: seed_compiler_codegen.cpp, linha 133-212
// Problema: parse_expr não trackeia tipos, gera type mismatch
// Sintoma: "match op { "+" => a + b, "/" => "Erro: divisão por zero" }"
//          Float misturado com String

fn bug2_explanation() effect io {
    io.println("BUG #2: Type Mismatch em Match")
    io.println("Linhas 31-37 em calculadora:")
    io.println("let result = match op {")
    io.println("    \"+\" => a + b              // Float")
    io.println("    \"/\" => if ... else a / b  // Float OU String!")
    io.println("    _ => \"Erro: ...\"          // String")
    io.println("}")
    io.println("")
    io.println("Parser não valida que TODAS as branches retornam o mesmo tipo!")
}

